{
  "id": "mysql",
  "name": "MySQL",
  "version": "0.1.0",
  "description": "Lire ou modifier une base MySQL ou MariaDB par une requête SQL.",
  "category": "data",
  "icon": "database",
  "color": "#00758f",
  "image": "mysql:8.4",
  "credential": {
    "type": "mysql",
    "env": { "CAD_MYSQL_HOST": "host", "CAD_MYSQL_PORT": "port", "CAD_MYSQL_DATABASE": "database", "CAD_MYSQL_USER": "user", "CAD_MYSQL_PASSWORD": "password", "CAD_MYSQL_SSLMODE": "sslmode" }
  },
  "parameters": [
    { "key": "operation", "type": "choice", "label": "Opération", "default": "query", "env": "CAD_OPERATION",
      "options": [{ "value": "query", "label": "Lire" }, { "value": "execute", "label": "Modifier" }] },
    { "key": "query", "type": "sql", "label": "Requête", "required": true, "env": "CAD_QUERY" },
    { "key": "limit", "type": "number", "label": "Lignes au plus", "default": 1000, "min": 1, "max": 100000, "env": "CAD_LIMIT", "showIf": { "operation": "query" } },
    { "key": "transaction", "type": "boolean", "label": "Dans une transaction", "default": true, "env": "CAD_TRANSACTION", "showIf": { "operation": "execute" } }
  ],
  "script": "run.sh",
  "command": ["sh", "/opt/cadriciel/run.sh"],
  "produces": [
    { "key": "rows", "type": "json", "path": "/data/output/rows.json" },
    { "key": "count", "type": "number", "path": "/data/output/count" }
  ],
  "resources": { "cpu": "200m", "memory": "512Mi" },
  "timeout": 300
}
