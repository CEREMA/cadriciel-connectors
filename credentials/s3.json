{
  "id": "s3",
  "name": "S3",
  "icon": "hard-drive",
  "color": "#e0803a",
  "fields": [
    { "key": "endpoint", "type": "text", "label": "Adresse", "required": true, "default": "https://s3.gra.io.cloud.ovh.net" },
    { "key": "region", "type": "text", "label": "Région", "required": true, "default": "gra" },
    { "key": "bucket", "type": "text", "label": "Espace" },
    { "key": "accessKey", "type": "text", "label": "Clé", "required": true },
    { "key": "secretKey", "type": "secret", "label": "Secret", "required": true }
  ],
  "test": {
    "image": "amazon/aws-cli:2.22.35",
    "env": { "AWS_ACCESS_KEY_ID": "accessKey", "AWS_SECRET_ACCESS_KEY": "secretKey", "AWS_DEFAULT_REGION": "region", "AWS_ENDPOINT_URL": "endpoint", "CAD_S3_BUCKET": "bucket" },
    "command": ["sh", "-c", "if [ -n \"${CAD_S3_BUCKET:-}\" ]; then aws s3 ls \"s3://$CAD_S3_BUCKET/\" --page-size 1 >/dev/null; else aws s3 ls >/dev/null; fi"]
  }
}
