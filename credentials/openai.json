{
  "id": "openai",
  "name": "OpenAI",
  "icon": "sparkles",
  "color": "#10a37f",
  "fields": [
    { "key": "apiKey", "type": "secret", "label": "Clé d'API", "required": true },
    { "key": "baseUrl", "type": "text", "label": "Adresse (facultatif)", "default": "https://api.openai.com/v1" }
  ],
  "test": {
    "image": "curlimages/curl:8.10.1",
    "env": { "OPENAI_API_KEY": "apiKey", "OPENAI_BASE_URL": "baseUrl" },
    "command": ["sh", "-c", "curl -fsS --max-time 10 -o /dev/null -H \"Authorization: Bearer $OPENAI_API_KEY\" \"${OPENAI_BASE_URL:-https://api.openai.com/v1}/models\""]
  }
}
