{
  "id": "postgres",
  "name": "PostgreSQL",
  "icon": "database",
  "color": "#336791",
  "fields": [
    { "key": "host", "type": "text", "label": "Hôte", "required": true },
    { "key": "port", "type": "number", "label": "Port", "default": 5432 },
    { "key": "database", "type": "text", "label": "Base", "required": true },
    { "key": "user", "type": "text", "label": "Utilisateur", "required": true },
    { "key": "password", "type": "secret", "label": "Mot de passe", "required": true },
    { "key": "sslmode", "type": "choice", "label": "Chiffrement", "default": "prefer", "options": ["disable", "prefer", "require", "verify-full"] }
  ],
  "test": {
    "image": "postgres:16-alpine",
    "env": { "PGHOST": "host", "PGPORT": "port", "PGDATABASE": "database", "PGUSER": "user", "PGPASSWORD": "password", "PGSSLMODE": "sslmode", "PGCONNECT_TIMEOUT": "5" },
    "command": ["psql", "-X", "-At", "-c", "select version()"]
  }
}
